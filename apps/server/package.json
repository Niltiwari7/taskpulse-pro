{
  "name": "server",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "postinstall": "prisma skills sync || exit 0",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "db:seed": "tsx src/scripts/seed.ts",
    "test": "dotenv run -q -f .env.test -- vitest run",
    "test:watch": "dotenv run -q -f .env.test -- vitest",
    "db:test:migrate": "dotenv run -q -f .env.test -- sh -c 'prisma db migrate --db \"$DATABASE_URL\"'",
    "db:migrate": "dotenv run -q -f .env -- sh -c 'prisma db migrate --db \"$DATABASE_URL\"'",
    "db:migrate:deploy": "prisma db migrate --db \"$DATABASE_URL\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.16.1",
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "@taskpulse/shared-types": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "zod": "^4.6.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "prisma": "8.0.0-rc.15",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
